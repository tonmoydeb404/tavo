{
  "name": "@workspace/desktop",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Tavo desktop app — Menu-bar audio control for macOS — switch devices, mute the mic, route app audio.",
  "license": "MIT",
  "author": "tonmoydeb404",
  "homepage": "https://tonmoydeb.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonmoydeb404/tavo.git",
    "directory": "apps/desktop"
  },
  "keywords": [
    "tauri",
    "desktop",
    "tavo"
  ],
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fontsource/amaranth": "^5.2.8",
    "@tabler/icons-react": "^3.44.0",
    "@tauri-apps/api": "^2",
    "@workspace/brand": "workspace:*",
    "@workspace/ui": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5.9.3",
    "vite": "^7.0.4"
  }
}
